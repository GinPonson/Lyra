# Docker Compose reads this file with format: raw (Compose >= 2.30).
# Values are literal: do not wrap them in quotes or add inline comments.
# Keep comments on their own lines. Dollar signs are passed through unchanged.

# init-env.py generates this value once for a NEW deployment.
# When upgrading, copy your existing key instead of generating a replacement.
LYRA_SECRET_MASTER_KEY=GENERATE_ONCE

# Enable at least ONE complete login group. Keep unused groups fully commented.
# Each configured identity grants access to the same private ledger; use only your own account.
# The first successful exchange pins that provider's subject. Email/name never links identities.
# Google: Web application OAuth client; owner email or subject is required.
# LYRA_LOGIN_GOOGLE_CLIENT_ID=replace-with-google-web-client-id
# LYRA_LOGIN_GOOGLE_CLIENT_SECRET=replace-with-google-web-client-secret
# LYRA_LOGIN_GOOGLE_REDIRECT_URI=https://lyra.example.com/v1/auth/google/callback
# LYRA_OWNER_EMAIL=your-google-account@example.com
# If email and subject are both set, both must match.
# LYRA_OWNER_GOOGLE_SUBJECT=replace-with-your-google-subject

# Linux.do: register at connect.linux.do and use your immutable positive numeric user ID.
# LYRA_LOGIN_LINUXDO_CLIENT_ID=replace-with-linuxdo-client-id
# LYRA_LOGIN_LINUXDO_CLIENT_SECRET=replace-with-linuxdo-client-secret
# LYRA_LOGIN_LINUXDO_REDIRECT_URI=https://lyra.example.com/v1/auth/linuxdo/callback
# LYRA_OWNER_LINUXDO_SUBJECT=replace-with-your-numeric-linuxdo-id

# GitHub: register an OAuth App; SUBJECT is your immutable numeric ID, not your login name.
# LYRA_LOGIN_GITHUB_CLIENT_ID=replace-with-github-client-id
# LYRA_LOGIN_GITHUB_CLIENT_SECRET=replace-with-github-client-secret
# LYRA_LOGIN_GITHUB_REDIRECT_URI=https://lyra.example.com/v1/auth/github/callback
# LYRA_OWNER_GITHUB_SUBJECT=replace-with-your-numeric-github-id

LYRA_GENKIT_BASE_URL=https://your-model-provider.example/v1
LYRA_GENKIT_MODEL=your-model-id
LYRA_GENKIT_API_KEY=replace-with-provider-api-key
LYRA_AGENT_TURN_TIMEOUT_MS=120000
LYRA_AGENT_MAX_TURNS=10

# 在「我的 → 行情与估值」选择股票/期权主备来源或关闭，每次选择自动提交，确认后立即生效并持久化。
# 同一所有者的全部设备与 Genkit 共用；接入说明见 docs/market-data.md。
# 下面两项仅在尚无保存记录时作为默认值，推荐维持 none；保存后的选择优先。
# 若旧默认值非 none，移除对应 Key 时也须将该默认值清为 none，不会覆盖界面保存的选择。
LYRA_MARKET_STOCK_PROVIDERS=none
LYRA_MARKET_OPTION_PROVIDERS=none
# 完整凭据使来源在 App 中可选，不会自动启用；未配置来源不可选。
# 修改密钥、模式、预算后，执行配置预检并重启；日常切源只需在 App 中选择，无需保存按钮。
# LYRA_ALPACA_API_KEY=your-alpaca-api-key
# LYRA_ALPACA_SECRET_KEY=your-alpaca-secret-key
# LYRA_MARKETDATA_API_TOKEN=your-marketdata-api-token
LYRA_MARKETDATA_MODE=historical
LYRA_MARKETDATA_DAILY_REQUEST_LIMIT=80
LYRA_MARKET_TIMEOUT_MS=8000

# To use only the ledger initially, remove ALL THREE LYRA_GENKIT_* lines above.
# Optional Gmail import credentials stay separate from all identity sign-in methods.
# Omit unused Gmail variables completely; do not pass empty values.
# LYRA_GOOGLE_CLIENT_ID=your-gmail-client-id
# LYRA_GOOGLE_CLIENT_SECRET=your-gmail-client-secret
# LYRA_GOOGLE_REDIRECT_URI=https://your-existing-gmail-callback
